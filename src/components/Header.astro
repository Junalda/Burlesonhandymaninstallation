---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { navLinks } from '../data/navigation';
import { whatsappLink } from '../data/site';
---

<header class="site-header" id="site-header" data-header>
  <div class="container site-header__inner">
    <Logo />

    <nav class="nav-desktop" aria-label="Hoofdnavigatie">
      <ul>
        {
          navLinks.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      {
        /* De WhatsApp-knop verschijnt automatisch zodra `whatsapp` in src/data/site.ts is
           ingevuld. Op smalle schermen wordt hij compact (alleen het icoon), zodat WhatsApp
           overal op de pagina met één tik bereikbaar blijft. */
        whatsappLink && (
          <a
            class="btn btn--outline header-cta header-cta--wa"
            href={whatsappLink}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="WhatsApp"
          >
            <Icon name="whatsapp" size={18} />
            <span class="header-cta__label">WhatsApp</span>
          </a>
        )
      }
      <a class="btn btn--accent header-cta" href="#contact">Neem contact op</a>

      <button
        type="button"
        class="nav-toggle"
        aria-expanded="false"
        aria-controls="mobile-nav"
        data-nav-toggle
      >
        <span class="visually-hidden">Menu openen</span>
        <Icon name="menu" size={22} class="nav-toggle__open" />
        <Icon name="close" size={22} class="nav-toggle__close" />
      </button>
    </div>
  </div>

  <div class="mobile-nav" id="mobile-nav" data-mobile-nav hidden>
    <nav class="container" aria-label="Mobiele navigatie">
      <ul>
        {
          navLinks.map((link) => (
            <li>
              <a href={link.href} data-nav-link>
                <span>{link.label}</span>
                <Icon name="arrowRight" size={18} />
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mobile-nav__actions">
        <a class="btn btn--accent btn--block" href="#contact" data-nav-link>Neem contact op</a>
        {
          whatsappLink && (
            <a
              class="btn btn--outline btn--block"
              href={whatsappLink}
              target="_blank"
              rel="noopener noreferrer"
            >
              <Icon name="whatsapp" size={18} />
              WhatsApp
            </a>
          )
        }
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.82);
    backdrop-filter: saturate(180%) blur(14px);
    -webkit-backdrop-filter: saturate(180%) blur(14px);
    border-bottom: 1px solid transparent;
    transition:
      background-color 0.3s var(--ease),
      border-color 0.3s var(--ease),
      box-shadow 0.3s var(--ease);
  }

  /* Achtergrond wordt vaster zodra er gescrold is. Bewust hoog genoeg om
     ook boven de donkere secties leesbaar te blijven. */
  .site-header[data-scrolled] {
    background: rgba(255, 255, 255, 0.96);
    border-bottom-color: var(--line);
    box-shadow: 0 1px 20px rgba(16, 17, 20, 0.05);
  }

  /* Browsers zonder backdrop-filter krijgen een dekkende achtergrond. */
  @supports not (backdrop-filter: blur(1px)) {
    .site-header {
      background: var(--paper);
    }
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);
    min-height: 74px;
  }

  .nav-desktop ul {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.4vw, 2.2rem);
    margin: 0;
  }

  .nav-desktop a {
    position: relative;
    display: inline-block;
    padding: 0.4rem 0;
    font-size: 0.95rem;
    font-weight: 560;
    color: var(--ink-soft);
    text-decoration: none;
    transition: color 0.2s var(--ease);
  }

  .nav-desktop a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s var(--ease);
  }

  .nav-desktop a:hover {
    color: var(--ink);
  }

  .nav-desktop a:hover::after,
  .nav-desktop a:focus-visible::after {
    transform: scaleX(1);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .header-cta {
    min-height: 44px;
    padding: 0.55rem 1.25rem;
    font-size: 0.95rem;
  }

  .nav-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    border: 1px solid var(--line-strong);
    border-radius: 12px;
    background: transparent;
    color: var(--ink);
  }

  /* `:global()` is nodig omdat de iconen uit het Icon-component komen en
     daardoor buiten de scope van dit component vallen. */
  .nav-toggle :global(.nav-toggle__close) {
    display: none;
  }

  .site-header[data-open] .nav-toggle :global(.nav-toggle__open) {
    display: none;
  }

  .site-header[data-open] .nav-toggle :global(.nav-toggle__close) {
    display: block;
  }

  .mobile-nav {
    border-top: 1px solid var(--line);
    background: var(--paper);
    padding-block: var(--space-s) var(--space-m);
  }

  .mobile-nav[hidden] {
    display: none;
  }

  .mobile-nav ul {
    margin: 0;
  }

  .mobile-nav li + li {
    border-top: 1px solid var(--line);
  }

  .mobile-nav a:not(.btn) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 56px;
    font-size: 1.05rem;
    font-weight: 580;
    text-decoration: none;
    color: var(--ink);
  }

  .mobile-nav a:not(.btn) :global(svg) {
    color: var(--accent);
  }

  .mobile-nav__actions {
    display: grid;
    gap: 0.6rem;
    margin-top: var(--space-m);
  }

  @media (max-width: 900px) {
    .nav-desktop {
      display: none;
    }

    .nav-toggle {
      display: inline-flex;
    }

    /* WhatsApp wordt compact: alleen het icoon, maar met behoud van een
       toegankelijke naam via het aria-label. */
    .header-cta--wa {
      width: 46px;
      padding-inline: 0;
    }

    .header-cta__label {
      display: none;
    }
  }

  @media (max-width: 560px) {
    /* Alleen de tekstuele CTA verdwijnt; WhatsApp blijft bereikbaar. */
    .header-cta:not(.header-cta--wa) {
      display: none;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-mobile-nav]');

  if (header && toggle && panel) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      panel.hidden = !open;
      header.toggleAttribute('data-open', open);
      document.body.style.overflow = open ? 'hidden' : '';
      const label = toggle.querySelector('.visually-hidden');
      if (label) label.textContent = open ? 'Menu sluiten' : 'Menu openen';
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    // Sluiten na het kiezen van een link.
    panel.querySelectorAll('[data-nav-link]').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });

    // Panel sluit weer wanneer we terugschalen naar desktop.
    const desktop = window.matchMedia('(min-width: 901px)');
    desktop.addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }

  // Achtergrond van de header verandert zodra er gescrold wordt.
  if (header) {
    const onScroll = () => {
      header.toggleAttribute('data-scrolled', window.scrollY > 12);
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>
