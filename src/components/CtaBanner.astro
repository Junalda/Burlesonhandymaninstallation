---
import Button from './Button.astro';
import Icon from './Icon.astro';
import { site, mailtoLink, telLink, whatsappLink } from '../data/site';

/**
 * Donkere CTA-sectie.
 *
 * De knoppenrij is bewust datagedreven: zodra `PUBLIC_PHONE` of
 * `PUBLIC_WHATSAPP` in `.env` staat, verschijnen de bel- en WhatsApp-knop hier
 * automatisch. Er wordt niets verzonnen zolang die waarden leeg zijn.
 */
---

<section class="section section--dark cta" aria-labelledby="cta-titel">
  <div class="cta__glow" aria-hidden="true"></div>

  <div class="container cta__inner">
    <div class="cta__text" data-reveal>
      <p class="eyebrow">Beschikbaarheid</p>
      <h2 class="section-title cta__title" id="cta-titel">
        Een vakman nodig voor uw volgende opdracht?
      </h2>
      <p class="section-intro">
        Heeft u ondersteuning nodig bij grondwerk, machinewerk, straatwerk of transport? Neem
        direct contact op en bespreek de mogelijkheden.
      </p>
    </div>

    <div class="cta__actions" data-reveal style="--reveal-delay: 90ms">
      <Button href="#contact" size="lg" icon="arrowRight">Neem contact op</Button>
      <Button href={mailtoLink} size="lg" variant="onDark" icon="mail" iconPosition="start">
        Stuur een e-mail
      </Button>
      {
        telLink && (
          <Button href={telLink} size="lg" variant="onDark" icon="phone" iconPosition="start">
            Bel direct
          </Button>
        )
      }
      {
        whatsappLink && (
          <Button
            href={whatsappLink}
            size="lg"
            variant="onDark"
            icon="whatsapp"
            iconPosition="start"
            external
          >
            WhatsApp
          </Button>
        )
      }

      <p class="cta__email">
        <Icon name="mail" size={18} />
        <a href={mailtoLink}>{site.contact.email}</a>
      </p>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    overflow: hidden;
  }

  .cta__glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 55% 70% at 82% 30%,
      rgba(245, 158, 11, 0.14),
      transparent 62%
    );
    pointer-events: none;
  }

  .cta__inner {
    position: relative;
    display: grid;
    gap: clamp(2rem, 1.2rem + 3vw, 3.5rem);
    align-items: center;
  }

  .cta__title {
    max-width: 18ch;
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .cta__email {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    width: 100%;
    margin-top: 0.5rem;
    font-size: var(--fs-sm);
    color: #b6b9be;
  }

  .cta__email :global(svg) {
    flex: none;
    color: var(--c-accent-bright);
  }

  .cta__email a {
    color: #fff;
    text-decoration: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.3);
    padding-block: 0.5rem;
    overflow-wrap: anywhere;
    transition: border-color var(--dur) var(--ease);
  }

  .cta__email a:hover {
    border-color: var(--c-accent-bright);
  }

  @media (min-width: 62rem) {
    .cta__inner {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    }

    .cta__actions {
      justify-content: flex-end;
    }

    .cta__email {
      justify-content: flex-end;
    }
  }
</style>
