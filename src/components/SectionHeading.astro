---
export interface Props {
  /** Klein label boven de kop. */
  eyebrow?: string;
  title: string;
  intro?: string;
  /** Kopniveau — de pagina gebruikt h1 alleen in de hero. */
  as?: 'h2' | 'h3';
  align?: 'start' | 'center';
  id?: string;
  class?: string;
}

const { eyebrow, title, intro, as: Tag = 'h2', align = 'start', id, class: className } = Astro.props;
---

<div
  class:list={['section-header', align === 'center' && 'section-header--center', className]}
  data-reveal
>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <Tag id={id} class="section-title">{title}</Tag>
  {intro && <p class="section-intro">{intro}</p>}
  <slot />
</div>

<style>
  .section-header--center {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .section-header--center :global(.section-title) {
    max-width: 24ch;
  }

  .section-header--center :global(.section-intro) {
    margin-inline: auto;
  }
</style>
