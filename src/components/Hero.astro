---
import Button from './Button.astro';
import Icon from './Icon.astro';
import { site } from '../data/site';

const trustPoints = ['Eigen vervoer', 'Eigen gereedschap', 'VCA gecertificeerd'];

/*
 * AFBEELDING TOEVOEGEN
 * -------------------
 * Plaats een professionele foto (grondwerk, machine of werk op locatie) in
 * `src/assets/hero.jpg` en vervang het blok `.hero__canvas` hieronder door:
 *
 *   ---
 *   import { Image } from 'astro:assets';
 *   import heroImage from '../assets/hero.jpg';
 *   ---
 *   <Image
 *     src={heroImage}
 *     alt="Raylison Burleson aan het werk met grondverzetmaterieel"
 *     widths={[480, 800, 1200]}
 *     sizes="(max-width: 960px) 100vw, 50vw"
 *     loading="eager"
 *     fetchpriority="high"
 *     class="hero__image"
 *   />
 *
 * De hero is bewust zo opgebouwd dat hij ook zonder foto af is.
 */
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero__inner">
    <div class="hero__copy">
      <p class="eyebrow">Grondwerk &middot; Transport &middot; Machinewerk</p>

      <h1 class="h1" id="hero-title">Vakwerk. Op tijd. Afspraak is afspraak.</h1>

      <p class="hero__sub">Grondwerk, transport en machinewerk waarop u kunt rekenen.</p>

      <p class="lead hero__intro">
        {site.name} ondersteunt bedrijven en projecten met professioneel grondwerk, transport en
        machinewerk. Met eigen vervoer, eigen gereedschappen en een betrouwbare werkmentaliteit
        staat {site.owner.split(' ')[0]} klaar om opdrachten efficiënt en zorgvuldig uit te voeren.
      </p>

      <div class="btn-row hero__actions">
        <Button href="#contact" variant="accent" icon="arrowRight">Bespreek uw opdracht</Button>
        <Button href="#diensten" variant="outline">Bekijk diensten</Button>
      </div>

      <ul class="hero__trust">
        {
          trustPoints.map((point) => (
            <li>
              <Icon name="check" size={16} />
              {point}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="hero__visual" aria-hidden="true">
      <div class="hero__canvas">
        <div class="hero__canvas-label">
          <span class="hero__canvas-eyebrow">Werkgebied</span>
          <span class="hero__canvas-value">{site.address.city}, {site.address.region} en omstreken</span>
        </div>
      </div>

      <div class="hero__badge">
        <span class="hero__badge-mark">VCA</span>
        <div>
          <strong>VCA &amp; GIB gecertificeerd</strong>
          <span>Veilig en verantwoord aan het werk</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(3rem, 2rem + 6vw, 6.5rem) clamp(3.5rem, 2rem + 6vw, 7rem);
    background:
      radial-gradient(60% 55% at 88% 8%, rgba(194, 84, 10, 0.07), transparent 70%),
      linear-gradient(180deg, var(--paper) 0%, var(--paper-soft) 100%);
    overflow: hidden;
  }

  /* Fijne rasterlijnen — een knipoog naar bouwtekeningen, bewust subtiel. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgba(22, 23, 26, 0.045) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(22, 23, 26, 0.045) 1px, transparent 1px);
    background-size: 84px 84px;
    mask-image: radial-gradient(75% 65% at 50% 0%, #000 20%, transparent 80%);
    -webkit-mask-image: radial-gradient(75% 65% at 50% 0%, #000 20%, transparent 80%);
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
    display: grid;
    gap: clamp(2.5rem, 2rem + 3vw, 4rem);
    align-items: center;
  }

  .hero__copy {
    max-width: 46rem;
  }

  .hero h1 {
    /* Iets compacter dan de globale h1, zodat de kop naast het visuele blok
       in twee gebalanceerde regels past. */
    font-size: clamp(2.05rem, 1.4rem + 2.6vw, 3.6rem);
    max-width: 21ch;
    margin-bottom: var(--space-s);
  }

  .hero__sub {
    font-size: var(--step-2);
    font-weight: 560;
    color: var(--ink-soft);
    letter-spacing: -0.02em;
    line-height: 1.3;
    max-width: 24ch;
    margin-bottom: var(--space-m);
  }

  .hero__intro {
    margin-bottom: var(--space-l);
  }

  .hero__actions {
    margin-bottom: var(--space-m);
  }

  .hero__trust {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.5rem;
    margin: 0;
    padding-top: var(--space-s);
    border-top: 1px solid var(--line);
  }

  .hero__trust li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.94rem;
    font-weight: 560;
    color: var(--ink-soft);
  }

  .hero__trust :global(svg) {
    color: var(--accent);
    flex: none;
  }

  /* --- Visueel blok (vervangbaar door een foto) --- */
  .hero__visual {
    position: relative;
    display: none;
  }

  .hero__canvas {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-l);
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.06) 0%, transparent 55%),
      linear-gradient(160deg, #1d1f24 0%, #101114 60%, #17181c 100%);
    box-shadow: var(--shadow-l);
    overflow: hidden;
  }

  .hero__canvas::before {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      -45deg,
      rgba(194, 84, 10, 0.5) 0 3px,
      transparent 3px 22px
    );
    opacity: 0.35;
  }

  .hero__canvas::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 45%;
    background: linear-gradient(to bottom, rgba(16, 17, 20, 0.92), transparent);
  }

  .hero__canvas-label {
    position: absolute;
    left: 1.75rem;
    top: 1.75rem;
    right: 1.75rem;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .hero__canvas-eyebrow {
    font-size: 0.7rem;
    font-weight: 620;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #f0a267;
  }

  .hero__canvas-value {
    color: rgba(255, 255, 255, 0.92);
    font-size: 1.05rem;
    font-weight: 570;
    letter-spacing: -0.015em;
    line-height: 1.35;
    max-width: 16ch;
  }

  .hero__badge {
    position: absolute;
    left: -1.75rem;
    bottom: 2rem;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.9rem 1.15rem;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    box-shadow: var(--shadow-m);
  }

  .hero__badge-mark {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    flex: none;
    border-radius: 10px;
    background: var(--accent-soft);
    color: var(--accent-ink);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.04em;
  }

  .hero__badge strong {
    display: block;
    font-size: 0.92rem;
    font-weight: 640;
  }

  .hero__badge span:not(.hero__badge-mark) {
    font-size: 0.82rem;
    color: var(--ink-muted);
  }

  /* Mobiel: compacter opbouwen zodat de primaire CTA snel in beeld is —
     veel bezoekers komen via WhatsApp of een doorverwijzing. */
  @media (max-width: 640px) {
    .hero {
      padding-block: 2.25rem 3rem;
    }

    .hero__sub {
      font-size: var(--step-1);
      margin-bottom: var(--space-s);
    }

    .hero__intro {
      font-size: var(--step-0);
      margin-bottom: var(--space-m);
    }

    .hero__actions {
      display: grid;
      gap: 0.6rem;
    }
  }

  @media (min-width: 961px) {
    .hero__inner {
      grid-template-columns: 1.28fr 0.72fr;
    }

    .hero__visual {
      display: block;
    }
  }
</style>
