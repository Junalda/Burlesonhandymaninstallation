---
import Logo from './Logo.astro';
import { footerLinks } from '../data/navigation';
import { site, mailtoLink } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <Logo tone="light" />
        <p class="site-footer__tagline">
          Grondwerk, transport en machinewerk voor opdrachtgevers in {site.address.city} en
          {site.address.region}.
        </p>
      </div>

      <div class="site-footer__cols">
        <div>
          <h2 class="site-footer__heading">Navigatie</h2>
          <ul>
            {
              footerLinks.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))
            }
          </ul>
        </div>

        <div>
          <h2 class="site-footer__heading">Gegevens</h2>
          <ul class="site-footer__info">
            <li>KVK: {site.kvk}</li>
            <li>
              <address>{site.address.street}, {site.address.postalCode} {site.address.city}</address>
            </li>
            <li><a href={mailtoLink}>{site.email}</a></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="site-footer__bottom">
      <p>&copy; {year} {site.name}. Alle rechten voorbehouden.</p>
      <p class="site-footer__legal">{site.legalForm} &middot; KVK {site.kvk}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--dark);
    color: var(--dark-text);
    padding-block: clamp(3rem, 2rem + 3vw, 4.5rem) var(--space-l);
    font-size: 0.95rem;
  }

  .site-footer__top {
    display: grid;
    gap: var(--space-l);
    padding-bottom: var(--space-l);
    border-bottom: 1px solid var(--dark-line);
  }

  .site-footer__tagline {
    margin-top: var(--space-s);
    max-width: 34ch;
    color: var(--dark-text);
    line-height: 1.6;
  }

  .site-footer__cols {
    display: grid;
    gap: var(--space-l);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 180px), 1fr));
  }

  .site-footer__heading {
    font-size: 0.78rem;
    font-weight: 620;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #fff;
    margin-bottom: var(--space-s);
  }

  .site-footer ul {
    display: grid;
    gap: 0.15rem;
    margin: 0;
  }

  .site-footer a {
    display: inline-block;
    color: var(--dark-text);
    text-decoration: none;
    /* Ruim tikdoel op mobiel. */
    padding-block: 0.4rem;
    word-break: break-word;
    transition: color 0.2s var(--ease);
  }

  .site-footer a:hover {
    color: #fff;
    text-decoration: underline;
  }

  .site-footer__info li {
    padding-block: 0.4rem;
  }

  .site-footer__info li:has(a) {
    padding-block: 0;
  }

  .site-footer address {
    font-style: normal;
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-top: var(--space-m);
    font-size: 0.87rem;
    color: #8b8f97;
  }

  @media (min-width: 861px) {
    .site-footer__top {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }
</style>
